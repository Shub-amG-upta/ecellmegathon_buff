# --- generated data: regenerate with `python -m data.generator.episode_build`
data/episodes/
data/episodes_dev/
data/experience/
results/*
!results/baselines/
# board campaign results are tracked (summaries, gzipped call logs, manifest, status);
# its scratch folders are not
!results/board/
results/board/tmp/
results/board/cache/
# the aborted first campaign (2026-10-03), kept in full: never used for a decision or a timing
!results/board_aborted_20261003/
# the presentation benchmark (single agent and multi-agent, same episodes) is tracked:
# summaries, gzipped runs, logs, lane proofs, temperatures. The raw per-tick files are
# not (the same ticks are in each <ep>_multi.run.json.gz), nor the scratch folders
!results/presentation_benchmark/
results/presentation_benchmark/**/*.ticks.jsonl
results/presentation_benchmark/**/*.ticks.interrupted-*.jsonl
results/presentation_benchmark/**/tmp/

# --- reference data: large, and not ours to redistribute
data/reference/*.csv

# --- device artefacts: multi-GB model files
device/models/*.litertlm
device/models/*.bin

# --- secrets
.env
*.key

# --- python
__pycache__/
*.pyc
.venv/
venv/

# --- macOS
.DS_Store
npu/maven/

# --- tokenizer files (licence terms): fetched by bench/token_count.py --fetch;
#     bench/tokenizers/manifest.json (repo, revision, sha256) IS committed
bench/tokenizers/*/

# --- build, download, quantize and board logs (large; kept local)
logs/
# zips the person made to hand the folders to another chat: copies of the folders above
results/presentation_benchmark/*.zip
# benchmarks made by scripts/benchmark.sh (bench/benchmark.py) are tracked: test.json,
# RESULTS.md, temps, summaries, gzipped run files, logs, lane proofs. Live tick files,
# kept stopped attempts and scratch folders are not; mock runs never are.
!results/benchmarks/
results/benchmarks/**/*.ticks.jsonl
results/benchmarks/**/*.interrupted-*
results/benchmarks/**/.tmp_*/
